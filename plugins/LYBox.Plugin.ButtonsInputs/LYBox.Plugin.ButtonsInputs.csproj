<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<PluginId>0F2F7DB6-0E9B-D872-442F-2CBC3DAC1F56</PluginId>
		<PluginName>Buttons &amp; Inputs Plugin</PluginName>
		<PluginAuthor>AvaloniaPlugin</PluginAuthor>
		<PluginDescription>UI component library for buttons and input controls</PluginDescription>
		<PluginVersion>1.0.0-preview.1</PluginVersion>
		<Version>$(PluginVersion)</Version>
		<MinPluginSdkVersion>2.0.0</MinPluginSdkVersion>
		<!-- 插件自带图标：宿主启动期通过 avares://{AssemblyName}/PluginIcons.axaml 加载并合并到 Application.Resources.MergedDictionaries -->
		<PluginIconResources>PluginIcons.axaml</PluginIconResources>
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="PluginIcons.axaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LYBox.Plugin.Generators" Version="$(PluginSdkVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<PackageReference Include="LYBox.Plugin.Shared" Version="$(PluginSdkVersion)" PrivateAssets="all" />
	</ItemGroup>
</Project>
