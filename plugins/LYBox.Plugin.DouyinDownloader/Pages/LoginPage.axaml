<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LYBox.Plugin.DouyinDownloader.ViewModels"
             x:Class="LYBox.Plugin.DouyinDownloader.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock Text="抖音登录" FontSize="18" FontWeight="Bold"/>
    <TextBlock Text="{Binding StatusText}" Classes="Tertiary"/>
    <Button Content="打开抖音登录页 (浏览器扫码)" Command="{Binding OpenLoginPageCommand}"/>
    <TextBlock Text="{Binding QrHint}" TextWrapping="Wrap" Classes="Tertiary"/>

    <TextBlock Text="手动粘贴 Cookie (浏览器 DevTools → Network → 任意请求 → Cookie)" FontWeight="Bold"/>
    <TextBox Text="{Binding ManualCookie, Mode=TwoWay}" AcceptsReturn="True" Height="120"
             Watermark="ttwid=...; odin_tt=...; passport_csrf_token=...; msToken=...;"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="导入 Cookie" Command="{Binding ImportManualCookieCommand}"/>
      <Button Content="检测有效性" Command="{Binding RecheckCommand}"/>
      <Button Content="清空 Cookie" Command="{Binding ClearCommand}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
