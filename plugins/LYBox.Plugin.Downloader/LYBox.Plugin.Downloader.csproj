<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<PluginId>B2C3D4E5-F6A7-8901-BCDE-DOWNLOADER001</PluginId>
		<PluginName>Downloader Plugin</PluginName>
		<PluginAuthor>Downloader</PluginAuthor>
		<PluginDescription>Pure C# HLS/DASH/MSS downloader (N_m3u8DL-RE compatible): VOD download, live record, decrypt &amp; mux, tool settings.</PluginDescription>
		<PluginVersion>1.0.0-preview.1</PluginVersion>
		<Version>$(PluginVersion)</Version>
		<MinPluginSdkVersion>2.0.0</MinPluginSdkVersion>
		<!-- Downloader 仅在 Windows + Linux 上验证过；macOS 上抖音/B 站签名路径尚未覆盖，宿主据此跳过加载。
		     使用 ',' 而不是 ';' 作为分隔符：Roslyn 源生成器从 .editorconfig 读取
		     MSBuild 属性时会把 ';' 视为段分隔符并截断；',' 在两端均兼容。 -->
		<PluginSupportedPlatforms>windows,linux</PluginSupportedPlatforms>
		<!-- 插件自带图标：宿主启动期通过 avares://{AssemblyName}/PluginIcons.axaml 加载并合并到 Application.Resources.MergedDictionaries -->
		<PluginIconResources>PluginIcons.axaml</PluginIconResources>
	</PropertyGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="PluginIcons.axaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CliWrap" Version="3.10.4" />
		<PackageReference Include="LYBox.Plugin.Generators" Version="$(PluginSdkVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<PackageReference Include="LYBox.Plugin.Shared" Version="$(PluginSdkVersion)" PrivateAssets="all" />
		<!-- 抖音子模块依赖（合并自 LYBox.Plugin.DouyinDownloader） -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

</Project>