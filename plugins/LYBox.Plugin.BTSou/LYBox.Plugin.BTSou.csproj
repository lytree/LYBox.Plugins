<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PluginId>BTSOU-PLUGIN-2026-0000-000000000001</PluginId>
    <PluginName>BTSou Search</PluginName>
    <PluginAuthor>KiongChan</PluginAuthor>
    <PluginDescription>BTSOU 精简版：BT 资源搜索 + 迅雷一键下载（已移除数据库/举报/授权逻辑，仅用于学习研究）。</PluginDescription>
    <PluginVersion>1.1.0-preview.1</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <MinPluginSdkVersion>2.0.0</MinPluginSdkVersion>
    <!-- BTSou 依赖迅雷 COM 互操作（Interop.ThunderAgentLib.dll），仅 Windows 可用。
         分隔符用 ','（Roslyn 源生成器从 .editorconfig 读取 MSBuild 属性时会把 ';' 视为段分隔符并截断）。-->
    <PluginSupportedPlatforms>windows</PluginSupportedPlatforms>
    <!-- 插件自带图标：宿主启动期通过 avares://{AssemblyName}/PluginIcons.axaml 加载并合并到 Application.Resources.MergedDictionaries -->
    <PluginIconResources>PluginIcons.axaml</PluginIconResources>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="PluginIcons.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LYBox.Plugin.Generators" Version="$(PluginSdkVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="LYBox.Plugin.Shared" Version="$(PluginSdkVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 迅雷下载组件（COM 互操作，本机需安装迅雷） -->
    <Reference Include="Interop.ThunderAgentLib">
      <HintPath>lib\Interop.ThunderAgentLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
