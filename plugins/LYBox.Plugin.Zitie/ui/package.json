{
  "name": "zitie-offline",
  "version": "1.0.0",
  "private": true,
  "description": "字帖生成器 · 离线版（Vue 3 + TSX 实现）",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node tools/verify-export.mjs",
    "fetch:strokes": "node tools/fetch-strokes.js"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}