<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<PluginId>A1B2C3D4-E5F6-7890-ABCD-TDLSHARP00001</PluginId>
		<PluginName>TDLSharp Plugin</PluginName>
		<PluginAuthor>TDLSharp</PluginAuthor>
		<PluginDescription>Telegram TDLib integration plugin providing batch forward, message export, media download and more.</PluginDescription>
		<PluginVersion>1.0.0-preview.1</PluginVersion>
		<Version>$(PluginVersion)</Version>
		<MinPluginSdkVersion>2.0.0</MinPluginSdkVersion>
		<!-- 插件自带图标：宿主启动期通过 avares://{AssemblyName}/PluginIcons.axaml 加载并合并到 Application.Resources.MergedDictionaries -->
		<PluginIconResources>PluginIcons.axaml</PluginIconResources>
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="PluginIcons.axaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="TDLib" Version="1.8.*" />
		<PackageReference Include="TDLib.Api" Version="1.8.*" />
		<PackageReference Include="tdlib.native" Version="1.8.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
		<!-- ILogger&lt;T&gt; 的 LogInformation / LogWarning / LogError 扩展方法来自本包,
		     SDK 包(2.3.0+)不再隐式传递,显式声明以兼容 .NET 10 SDK 的 NuGet 解析。 -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LYBox.Plugin.Generators" Version="$(PluginSdkVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<PackageReference Include="LYBox.Plugin.Shared" Version="$(PluginSdkVersion)" PrivateAssets="all" />
	</ItemGroup>
</Project>
