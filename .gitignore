# Build results
artifacts/

# NuGet Packages
*.nupkg
*.snupkg

# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except nuget/, which may hold a committed local feed
!**/[Pp]ackages/nuget/
!**/[Pp]ackages/nuget/*.nupkg

# NuGet v3 project.json files
*.nuget.props
*.nuget.targets

# Visual Studio / JetBrains
.vs/
.idea/
*.user
*.suo

# macOS
.DS_Store

# Logs / misc (kept here; projects rely on .gitignore at repo root)
*.log
