    },
    {
      "label": "build-current-plugin",
      "command": "dotnet.exe",
      "type": "process",
      "args": [
        "build",
        "${file}",
        "-c", "Debug",
        "/p:UseArtifactsOutput=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "clean-plugin-output",
      "command": "powershell.exe",
      "type": "shell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command", "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue '${workspaceFolder}\\artifacts\\bin\\LYBox.Plugin.${input:pluginName}\\Debug' ; Remove-Item -Recurse -Force -ErrorAction SilentlyContinue '${workspaceFolder}\\artifacts\\obj\\LYBox.Plugin.${input:pluginName}\\Debug'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "pluginName",
      "type": "promptString",
      "description": "Enter plugin name (without LYBox.Plugin. prefix)",
      "default": "ButtonsInputs"
    }
  ]
