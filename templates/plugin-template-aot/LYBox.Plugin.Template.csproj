<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LYBox Plugin Template (Native Avalonia)
    模板来源：plugins/LYBox.Plugin.Template
    迁移目的：把"可复制脚手架"与"参与发布的示例插件"分离
              → plugins/ 仅放要发布的；templates/ 仅放可复制粘贴的脚手架
    注意：本 csproj 仅在用户复制本目录为新插件时由开发者手动维护，
          不会被 build.cs 自动扫描/打包（build.cs 仅扫 plugins/）。
    注意：复制后请把 <PluginId> <PluginName> <PluginAuthor> <PluginDescription> <PluginVersion>
          改为你的实际值；<PluginId> 必须全局唯一（GUID）。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- ↓↓↓ 替换为你的插件信息 ↓↓↓ -->
    <PluginId>TEMPLATE-AOT-0000-0000-000000000000</PluginId>
    <PluginName>Plugin Template (Native)</PluginName>
    <PluginAuthor>AvaloniaPlugin</PluginAuthor>
    <PluginDescription>Native Avalonia plugin template (CLI greeting + counter demo)</PluginDescription>
    <PluginVersion>1.0.0-preview.1</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <MinPluginSdkVersion>2.0.0</MinPluginSdkVersion>
    <IsPluginProject>true</IsPluginProject>
    <GeneratePluginCliIndex>true</GeneratePluginCliIndex>
    <PluginCliAlias>template-aot</PluginCliAlias>
    <PluginCliDescription>Create a greeting from the native template plugin.</PluginCliDescription>
    <PluginCliRuntimeProfile>selected</PluginCliRuntimeProfile>
    <PluginCliOutputModes>text;json</PluginCliOutputModes>
    <!-- 插件自带图标：宿主启动期通过 avares://{AssemblyName}/PluginIcons.axaml 加载并合并到 Application.Resources.MergedDictionaries -->
    <PluginIconResources>PluginIcons.axaml</PluginIconResources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="PluginIcons.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LYBox.Plugin.Generators" Version="$(PluginSdkVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="LYBox.Plugin.CommandLine" Version="$(PluginSdkVersion)" PrivateAssets="all" />
    <PackageReference Include="LYBox.Plugin.Shared" Version="$(PluginSdkVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>