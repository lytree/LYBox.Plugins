<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <!-- 本地 SDK feed：用环境变量 LYBOX_SDK_FEED 指向主题+SDK 仓库的 artifacts/packages/sdk。未设置时回退 nuget.org。build.cs 通过参数 sdk-feed / sdk-feed-path 精确控制（参见 README）。 -->
    <add key="AvaloniaPluginLocal" value="%LYBOX_SDK_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>