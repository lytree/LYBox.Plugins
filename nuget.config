<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <!-- 本地 SDK feed：由 LYBOX_SDK_FEED 环境变量驱动（插件 build.cs 的 sdk-feed 参数会设置它）。
         未设置时该路径字面量不存在，NuGet 跳过此源并回退 nuget.org。 -->
    <add key="LYBoxSdkLocal" value="%LYBOX_SDK_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>